<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="table_scene">

    <!--
      Physics settings.
      We use a 1ms timestep which gives stable simulation for rigid body contact.
      Real time factor 1.0 means simulation runs at the same speed as wall clock time.
    -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Plugins that Gazebo Harmonic needs to simulate sensors and physics -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- Lighting: a directional sun light so the camera gets realistic color images -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane so objects don't fall forever -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      TABLE
      A simple white box at height 0.375m (standard table height / 2 because
      the origin is at the center of the box, so top surface is at 0.75m).
      We mark it static=true so physics doesn't waste time simulating it falling.
    -->
    <model name="table">
      <static>true</static>
      <pose>0.8 0 0 0 0 0</pose>
      <link name="link">
        <!-- Tabletop slab: 5cm thick, top surface still at z=0.75 -->
        <collision name="top_collision">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>

        <!-- Four legs, 5cm square, from floor to underside of slab (z=0.70) -->
        <collision name="leg_fl_collision">
          <pose>0.54 0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_fl_visual">
          <pose>0.54 0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>

        <collision name="leg_fr_collision">
          <pose>0.54 -0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.54 -0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>

        <collision name="leg_bl_collision">
          <pose>-0.54 0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.54 0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>

        <collision name="leg_br_collision">
          <pose>-0.54 -0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>-0.54 -0.34 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Target object: sugar box (YCB object 004).
      Sits on the table top at z=0.75m, center at z=0.794m.
      Given a distinct red color so SAM2 can segment it easily.
    -->
    <model name="sugar_box">
      <pose>0.8 0.0 0.838 0 0 0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.514</mass>
          <inertia>
            <ixx>0.001707</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001432</iyy><iyz>0</iyz>
            <izz>0.0004847</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.0495 0.0942 0.176</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.0495 0.0942 0.176</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="box_contact" type="contact">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
        </sensor>
      </link>
    </model>

    <!--
      RGB-D camera, angled downward at the table like a wrist-mounted camera.
      Has an RGB sensor and a depth sensor, both at 30Hz, matching a RealSense.
      Topic names match what ros_gz_bridge forwards to ROS2.
    -->
    <model name="realsense_d435i">
      <static>true</static>
      <pose>0.8 0.5 1.45 0 0.8858 -1.5708</pose>
      <link name="link">

        <visual name="visual">
          <geometry>
            <box><size>0.025 0.09 0.025</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <!-- RGB sensor -->
        <sensor name="color_camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.211</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <topic>camera/color/image_raw</topic>
        </sensor>

        <!-- Depth sensor -->
        <sensor name="depth_camera" type="depth_camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.211</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <topic>camera/depth/image_raw</topic>
        </sensor>

      </link>
    </model>

  </world>
</sdf>